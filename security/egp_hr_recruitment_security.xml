        <!-- Record rules for website.contact -->
        <record id="website_contact_comp_rule" model="ir.rule">
            <field name="name">Website Contact: Multi-Company</field>
            <field name="model_id" ref="model_website_contact"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
