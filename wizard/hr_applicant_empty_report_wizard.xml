<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--EGP hr.applicant  Report Wizard form view-->
        <record id="view_hr_applicant_empty_report_form" model="ir.ui.view">
            <field name="name">hr.applicant.empty.report.form</field>
            <field name="model">hr.applicant.empty.report</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="position_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_print_report" string="Print" class="btn btn-primary" type="object"/>
                        <button string="Cancel" class="btn btn-danger" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_hr_applicant_empty_report" model="ir.actions.act_window">
            <field name="name">Job Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.applicant.empty.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <menuitem id="menu_recruitment_empty_position"
                  name="Unallocated Seats"
                  parent="hr_recruitment.report_hr_recruitment"
                  action="action_hr_applicant_empty_report"
                  sequence="101"/>
    </data>

</odoo>