<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- egp hr job summary report action -->
    <record id="action_report_job_summary" model="ir.actions.report">
        <field name="name">Position</field>
        <field name="model">hr.job</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">egp_hr_recruitment.report_custom_job_description_template_recruitment</field>
        <field name="report_file">egp_hr_recruitment.report_custom_job_description_template_recruitment</field>
        <field name="print_report_name">'Position - %s' % (object.name).replace('/', '')</field>
        <field name="binding_model_id" ref="model_hr_job"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="egp_hr_org_structure.report_paperformat_a4"/>
        <field name="groups_id"
               eval="[(4, ref('egp_hr_recruitment.group_recruitment_expert')),(4, ref('egp_hr_recruitment.group_recruitment_amir'))]"/>
    </record>

