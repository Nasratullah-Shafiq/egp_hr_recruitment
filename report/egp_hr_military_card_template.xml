                            <t t-if="employee.avatar_1920">

                                <div style="
                            position:absolute;

                            top:2.8mm;
                            left:2.5mm;

                            width:8mm;
                            height:10mm;

                            margin:0;
                            padding:0;

                            overflow:hidden;

                            z-index:10;
                        ">

                                    <img
                                            t-att-src="image_data_uri(employee.avatar_1920)"
                                            alt="Employee Photo"
                                            style="
                                    width:8mm;
                                    height:10mm;

                                    display:block;

                                    margin:0;
                                    padding:0;

                                    border:0;

                                    object-fit:cover;
                                "
                                    />

                                </div>

                            </t>


                            <!-- ================================================= -->
                            <!-- EMPLOYEE NUMBER                                   -->
                            <!-- ================================================= -->

                            <div style="
                        position:absolute;

                        top:10.7mm;
                        left:3mm;

                        width:7mm;
                        height:4mm;

                        margin:0;
                        padding:0;

                        font-family:'Arial', sans-serif;
                        font-size:8px;
                        font-weight:bold;

                        direction:ltr;
                        text-align:center;

                        white-space:nowrap;

                        color:#000000;

                        z-index:20;
                    ">

                                <span t-if="employee.barcode"
                                      t-field="employee.barcode"/>

                            </div>


                            <!-- ================================================= -->
                            <!-- ENGLISH INFORMATION TABLE                         -->
                            <!-- ================================================= -->

                            <table style="
                        position:absolute;

                        top:15.5mm;
                        left:2.5mm;

                        width:49mm;

                        margin:0;
                        padding:0;

                        border-collapse:collapse;
                        border-spacing:0;

                        font-family:'Calibri', Arial, sans-serif;
                        font-size:8.5px;
                        font-weight:bold;

                        direction:ltr;

                        z-index:20;
                    ">


                                <!-- ============================================= -->
                                <!-- NAME                                           -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:15mm;

                                padding:0.6mm 0.5mm;

                                text-align:left;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        Name:
                                    </td>

                                    <td style="
                                width:34mm;

                                padding:0.6mm 0.5mm;

                                text-align:left;
                                vertical-align:middle;

                                direction:ltr;

                                white-space:nowrap;
                                overflow:hidden;

                                font-weight:bold;
                                color:#000000;
                            ">

                                        <span t-if="employee.english_name"
                                              t-field="employee.english_name"/>

                                    </td>

                                </tr>


                                <!-- ============================================= -->
                                <!-- FATHER NAME                                    -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:15mm;

                                padding:0.6mm 0.5mm;

                                text-align:left;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        F/Name:
                                    </td>

                                    <td style="
                                width:34mm;

                                padding:0.6mm 0.5mm;

                                text-align:left;
                                vertical-align:middle;

                                direction:ltr;

                                white-space:nowrap;
                                overflow:hidden;

                                font-weight:bold;
                                color:#000000;
                            ">

                                        <span t-if="employee.english_father_name"
                                              t-field="employee.english_father_name"/>

                                    </td>

                                </tr>


                                <!-- ============================================= -->
                                <!-- POSITION                                       -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:15mm;

                                padding:0.6mm 0.5mm;

                                text-align:left;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        Position:
                                    </td>

                                    <td style="
                                width:34mm;



                                text-align:left;
                                vertical-align:middle;

                                direction:ltr;

                                white-space:nowrap;
                                overflow:hidden;

                                font-weight:bold;
                                color:#000000;
                            ">

                                        <span t-if="employee.english_job_position"
                                              t-field="employee.english_job_position"/>

                                    </td>

                                </tr>


                            </table>


                            <!-- ================================================= -->
                            <!-- COURT LOGO                                        -->
                            <!-- ================================================= -->

                            <div style="
                        position:absolute;

                        top:28mm;
                        left:15mm;

                        width:24mm;
                        height:24mm;

                        margin:0;
                        padding:0;

                        overflow:hidden;

                        z-index:10;
                    ">

                                <img
                                        src="/egp_hr_recruitment/static/img/court_logo.png"
                                        alt="Supreme Court Logo"
                                        style="
                                width:24mm;
                                height:24mm;

                                display:block;

                                margin:0;
                                padding:0;

                                border:0;

                                object-fit:contain;
                            "
                                />

                            </div>


                            <!-- ================================================= -->
                            <!-- QR CODE                                            -->
                            <!-- ================================================= -->

                            <t t-if="employee.qr_code">

                                <div style="
                            position:absolute;

                            top:52.5mm;
                            left:15mm;

                            width:24mm;
                            height:24mm;

                            margin:0;
                            padding:0;

                            overflow:hidden;

                            z-index:20;
                        ">

                                    <img
                                            t-att-src="'/web/image/hr.employee/' + str(employee.id) + '/qr_code'"
                                            alt="QR Code"
                                            style="
                                    width:24mm;
                                    height:24mm;

                                    display:block;

                                    margin:0;
                                    padding:0;

                                    border:0;

                                    object-fit:contain;
                                "
                                    />

                                </div>

                            </t>


                            <!-- ================================================= -->
                            <!-- CARD NUMBER / INSTRUCTION                         -->
                            <!-- ================================================= -->

                            <div style="
                        position:absolute;

                        top:76.5mm;
                        left:3mm;

                        width:48mm;
                        height:7mm;

                        margin:0;
                        padding:0;

                        font-family:'Calibri', Arial, sans-serif;
                        font-size:7.5px;
                        font-weight:bold;

                        direction:rtl;
                        text-align:center;

                        line-height:3.5mm;

                        overflow:hidden;

                        color:#000000;

                        z-index:25;
                    ">

                                دکارت مونږ له پروخت مهرباني وکړئ
                                په لاندې پته یې را ولیږئ

                            </div>


                            <!-- ================================================= -->
                            <!-- FOOTER / CONTACT                                  -->
                            <!-- ================================================= -->

                            <div style="
                        position:absolute;

                        bottom:0;
                        left:0;

                        width:54mm;
                        height:8.5mm;

                        margin:0;
                        padding:0;

                        background:#000000;

                        font-family:'Calibri', Arial, sans-serif;
                        font-size:7.5px;
                        font-weight:bold;

                        direction:rtl;
                        text-align:center;

                        line-height:3.5mm;

                        color:#ffffff;

                        z-index:30;
                    ">

                                <div style="
                            margin:0;
                            padding:0;
                        ">

                                    پته: د قصبي سرک د کابل پوسټ ۱۵ حوزه / کابل افغانستان

                                </div>

                                <div style="
                            margin:0;
                            padding:0;
                        ">

                                    د اړیکې شمیره:
                                    <span dir="ltr">
                                        0791507696
                                    </span>

                                </div>

                            </div>


                        </div>

                    </div>

                </t>

            </t>

        </t>
    </template>
</odoo>

