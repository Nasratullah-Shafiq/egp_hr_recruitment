

<odoo>
    <template id="military_employee_card">

<!-- ============================================================= -->
<!-- FRONT SIDE                                                    -->
<!-- ============================================================= -->
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="employee">

                <t t-call="web.basic_layout">

                    <div class="page"
                         style="
                    width:54mm;
                    height:87.2mm;
                    margin:0;
                    padding:0;
                    overflow:hidden;
                    position:relative;
                 ">

                        <div style="
                    position:relative;
                    width:54mm;
                    height:87.2mm;
                    margin:0;
                    padding:0;
                    overflow:hidden;
                ">



                            <!-- ================================================= -->
                            <!-- CARD BACKGROUND                                    -->
                            <!-- ================================================= -->

                            <img
                                    src="/egp_hr_recruitment/static/img/court_employee_military_card.png"
                                    alt="Military Employee Card"
                                    style="
                            position:absolute;
                            top:0;
                            left:0;

                            width:54mm;
                            height:87.2mm;

                            margin:0;
                            padding:0;
                            border:0;

                            display:block;

                            z-index:1;
                        "
                            />


                            <!-- ================================================= -->
                            <!-- EMPLOYEE PHOTO                                    -->
                            <!-- ================================================= -->

                            <t t-if="employee.avatar_1920">

                                <div style="
                            position:absolute;

                            top:18.3mm;
                            right:0.2mm;

                            width:17.5mm;
                            height:23.2mm;

                            margin:0;
                            padding:0;

                            overflow:hidden;

                            z-index:10;
                        ">

                                    <img
                                            t-att-src="image_data_uri(employee.avatar_1920)"
                                            alt="Employee Photo"
                                            style="
                                    width:17.5mm;
                                    height:23.2mm;

                                    display:block;

                                    margin:0;
                                    padding:0;

                                    border:0;

                                    object-fit:cover;
                                "
                                    />

                                </div>

                            </t>


                            <!-- ================================================= -->
                            <!-- EMPLOYEE INFORMATION TABLE                        -->
                            <!-- ================================================= -->

                            <table style="
                        position:absolute;

                        top:42.5mm;
                        left:2mm;

                        width:50mm;

                        margin:0;
                        padding:0;

                        border-collapse:collapse;
                        border-spacing:0;

                        font-family:'Calibri', Arial, sans-serif;
                        font-size:9px;
                        font-weight:bold;

                        direction:rtl;

                        z-index:20;
                    ">

                                <!-- ============================================= -->
                                <!-- NAME                                           -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:19mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        نوم او تخلص:
                                    </td>

                                    <td style="
                                width:31mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                white-space:nowrap;
                                overflow:hidden;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        <span t-if="employee.name"
                                              t-field="employee.name"/>
                                    </td>

                                </tr>


                                <!-- ============================================= -->
                                <!-- FATHER NAME                                    -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:19mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        د پلار نوم:
                                    </td>

                                    <td style="
                                width:31mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                white-space:nowrap;
                                overflow:hidden;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        <span t-if="employee.father_name"
                                              t-field="employee.father_name"/>
                                    </td>

                                </tr>


                                <!-- ============================================= -->
                                <!-- JOB                                             -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:19mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        دنده:
                                    </td>

                                    <td style="
                                width:31mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                font-weight:bold;
                                color:#000000;

                                line-height:3.5mm;
                            ">
                                        <span t-if="employee.job_id"
                                              t-field="employee.job_id.name"/>
                                    </td>

                                </tr>


                                <!-- ============================================= -->
                                <!-- ISSUE DATE                                     -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:19mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        د صدور نیټه:
                                    </td>

                                    <td style="
                                width:31mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                direction:ltr;

                                white-space:nowrap;

                                font-family:'Arial', sans-serif;
                                font-size:9px;
                                font-weight:bold;

                                color:#000000;
                            ">

                                        <span t-if="employee.identification_print_date"
                                              t-esc="employee.identification_print_date.strftime('%Y-%m-%d')"/>

                                    </td>

                                </tr>


                                <!-- ============================================= -->
                                <!-- EXPIRY DATE                                    -->
                                <!-- ============================================= -->

                                <tr>

                                    <td style="
                                width:19mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                white-space:nowrap;

                                font-weight:bold;
                                color:#000000;
                            ">
                                        د پای ته رسیدو نیټه:
                                    </td>

                                    <td style="
                                width:31mm;

                                padding:0.7mm 0.5mm;

                                text-align:right;
                                vertical-align:middle;

                                direction:ltr;

                                white-space:nowrap;

                                font-family:'Arial', sans-serif;
                                font-size:9px;
                                font-weight:bold;

                                color:#000000;
                            ">

                                        <span t-if="employee.identification_expiry_date"
                                              t-esc="employee.identification_expiry_date.strftime('%Y-%m-%d')"/>

                                    </td>

                                </tr>

                            </table>


                            <!-- ================================================= -->
                            <!-- CARD NUMBER                                       -->
                            <!-- ================================================= -->

                            <div style="
                        position:absolute;

                        top:59.8mm;
                        left:7mm;

                        width:40mm;
                        height:5mm;

                        margin:0;
                        padding:0;

                        font-family:'Arial', sans-serif;
                        font-size:10px;
                        font-weight:bold;

                        direction:rtl;
                        text-align:right;

                        white-space:nowrap;
                        overflow:hidden;

                        color:#ff0000;

                        z-index:25;
                    ">

                                <span t-if="employee.barcode"
                                      t-field="employee.barcode"/>

                            </div>


                            <!-- ================================================= -->
                            <!-- BLOOD GROUP                                       -->
                            <!-- ================================================= -->

                            <div style="
                        position:absolute;

                        top:64.2mm;
                        left:20mm;

                        width:20mm;
                        height:5mm;

                        margin:0;
                        padding:0;

                        font-family:'Arial', sans-serif;
                        font-size:10px;
                        font-weight:bold;

                        direction:ltr;
                        text-align:center;

                        white-space:nowrap;

                        color:#ff0000;

                        z-index:25;
                    ">

                                <span t-if="employee.blood_group"
                                      t-field="employee.blood_group"/>

                            </div>


                            <!-- ================================================= -->
                            <!-- BARCODE                                            -->
                            <!-- ================================================= -->

                            <t t-if="employee.barcode">

                                <div style="
                            position:absolute;

                            top:76.5mm;
                            left:21mm;

                            width:27mm;
                            height:6mm;

                            margin:0;
                            padding:0;

                            overflow:hidden;

                            z-index:30;
                        ">

                                    <img
                                            t-att-src="'/report/barcode/Code128/' + employee.barcode"
                                            alt="Barcode"
                                            style="
                                    width:27mm;
                                    height:5mm;

                                    display:block;

                                    margin:0;
                                    padding:0;

                                    border:0;
                                "
                                    />

                                </div>

                            </t>


                        </div>

                    </div>

                </t>

            </t>

        </t>


        <!-- ============================================================= -->
        <!-- BACK SIDE OF MILITARY EMPLOYEE CARD                           -->
        <!-- ============================================================= -->

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="employee">

                <t t-call="web.basic_layout">

                    <div class="page"
                         style="
                    width:54mm;
                    height:87.2mm;
                    margin:0;
                    padding:0;
                    overflow:hidden;
                    position:relative;
                 ">

                        <div style="
                    position:relative;
                    width:54mm;
                    height:87.2mm;
                    margin:0;
                    padding:0;
                    overflow:hidden;
                ">


                            <!-- ================================================= -->
                            <!-- BACKGROUND                                         -->
                            <!-- ================================================= -->

                            <img
                                    src="/egp_hr_recruitment/static/img/court_employee_military_card_2.png"
                                    alt="Military Employee Card Back"
                                    style="
                            position:absolute;

                            top:0;
                            left:0;

                            width:54mm;
                            height:87.2mm;

                            margin:0;
                            padding:0;
                            border:0;

                            display:block;

                            z-index:1;
                        "
                            />


                            <!-- ================================================= -->
