<odoo>

    <template id="arcs_employee_card">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="employee">

                <t t-call="web.basic_layout">

                    <div class="page">

                        <div style="
    position:relative;
    width:85.6mm;
    height:54mm;
    overflow:hidden;
    margin:0;
    padding:0;
">


    <!-- ===================================================== -->
    <!-- BACKGROUND IMAGE                                       -->
    <!-- ===================================================== -->

    <img
        src="/egp_hr_recruitment/static/img/ARCS_employee_card.png"
        style="
            position:absolute;
            top:0;
            left:0;
            width:85.6mm;
            height:54mm;
            z-index:0;
            display:block;
        "
    />


    <!-- ===================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ===================================================== -->

    <table style="
        position:absolute;
        top:16mm;
        left:2mm;
        width:81.6mm;
        height:30mm;
        border-collapse:collapse;
        border-spacing:0;
        z-index:10;
        font-family:Calibri, Arial, sans-serif;
        table-layout:fixed;
    ">

        <tr>

            <!-- ================================================= -->
            <!-- PHOTO - LEFT                                      -->
            <!-- ================================================= -->

            <td style="
                width:22mm;
                padding:0;
                margin:0;
                vertical-align:top;
                text-align:center;
            ">

<t t-if="employee.avatar_1920">

    <img
        t-att-src="image_data_uri(employee.avatar_1920)"
        style="
            width:18mm;
            height:22mm;
            display:block;
            margin-left:3mm;
            margin-top:4mm;

            border-radius:50%;
            object-fit:cover;
            box-sizing:border-box;
        "
        alt="Employee Photo"
    />

</t>



            </td>


            <!-- ================================================= -->
            <!-- ENGLISH INFORMATION - MIDDLE                      -->
            <!-- ================================================= -->

            <td style="
                width:28mm;
                padding:0;
                margin:0;
                vertical-align:top;
                direction:ltr;
                text-align:left;
            ">

                <!-- NAME -->

                <div style="
                    margin:0 0 2.2mm 0;
                    padding:0;
                    line-height:1;
                ">

                    <div style="
                        font-size:6.5px;
                        font-weight:normal;
                        margin-bottom:0.6mm;
                    ">
                        FULL NAME
                    </div>

                    <div style="
                        font-size:8.5px;
                        font-weight:bold;
                        line-height:1.1;
                        white-space:nowrap;
                        overflow:hidden;
                    ">
                        <span t-field="employee.english_name"/>
                    </div>

                </div>


                <!-- POSITION -->

                <div style="
                    margin:0 0 2.2mm 0;
                    padding:0;
                    line-height:1;
                    width:100%;
                    box-sizing:border-box;
                ">

                    <div style="
                        font-size:6.5px;
                        font-weight:normal;
                        margin-bottom:0.6mm;
                    ">
                        Position
                    </div>

                    <div style="
                        font-size:8.5px;
                        font-weight:bold;
                        line-height:1.1;
                        width:100%;
                        max-width:100%;
                        white-space:normal;
                        overflow:hidden;
                        overflow-wrap:anywhere;
                        word-wrap:break-word;
                        word-break:normal;
                        box-sizing:border-box;
                        padding-right:1.5mm;
                    ">
                        <span t-field="employee.english_job_position"/>
                    </div>

                </div>



                <!-- Department -->


<!-- Department -->

<div style="
    margin:0 0 2.2mm 0;
    padding:0;
    line-height:1;
">

    <div style="
        font-size:6.5px;
        font-weight:normal;
        margin-bottom:0.6mm;
    ">
        Department
    </div>

    <div style="
        font-size:8.5px;
        font-weight:bold;
        line-height:1.1;
        width:100%;
        max-width:100%;
        white-space:normal;
        overflow-wrap:break-word;
        word-wrap:break-word;
        word-break:normal;
        padding-right:1.5mm;
        box-sizing:border-box;
    ">
        <span t-field="employee.english_department"/>
    </div>

</div>




                <!-- EXPIRY DATE -->

                <div style="
                    margin:0;
                    padding:0;
                    line-height:1;
                ">

                    <div style="
                        font-size:6.5px;
                        font-weight:normal;
                        margin-bottom:0.6mm;
                    ">
                        EXPIRY DATE
                    </div>

                    <div style="
                        font-size:8px;
                        font-weight:bold;
                        line-height:1.1;
                    ">
                        <span t-field="employee.identification_expiry_date"/>
                    </div>

                </div>

            </td>


            <!-- ================================================= -->
            <!-- DARI / PASHTO INFORMATION - RIGHT                 -->
            <!-- ================================================= -->

            <td style="
                width:31.6mm;
                padding:0;
                margin:0;
                vertical-align:top;
                direction:rtl;
                text-align:right;
            ">

                <!-- NAME -->

                <div style="
                    margin:0 0 2.2mm 0;
                    padding:0;
                    line-height:1;
                ">

                    <div style="
                        font-size:6.5px;
                        font-weight:normal;
                        margin-bottom:0.6mm;
                    ">
                        نوم او تخلص:
                    </div>

                    <div style="
                        font-size:9px;
                        font-weight:bold;
                        line-height:1.1;
                        white-space:nowrap;
                        overflow:hidden;
                    ">
                        <span t-field="employee.name"/>
                    </div>

                </div>

                <!-- JOB -->


                <!-- Job Position -->

                <div style="
                    margin:0 0 2.2mm 0;
                    padding:0;
                    line-height:1;
                ">

                    <div style="
                        font-size:6.5px;
                        font-weight:normal;
                        margin-bottom:0.6mm;
                    ">
                        دنده / وظیفه:
                    </div>

                    <div style="
                        font-size:9px;
                        font-weight:bold;
                        line-height:1.1;
                        width:100%;
                        max-width:100%;
                        white-space:normal;
                        overflow-wrap:break-word;
                        word-wrap:break-word;
                        word-break:normal;
                        padding-right:1.5mm;
                        box-sizing:border-box;
                    ">
                        <span t-field="employee.job_id.name"/>
                    </div>

                </div>




                <!-- Department -->

                <div style="
                    margin:0 0 2.2mm 0;
                    padding:0;
                    line-height:1;
                ">

                    <div style="
                        font-size:6.5px;
                        font-weight:normal;
                        margin-bottom:0.6mm;
                    ">
                        ریاست:
                    </div>

                    <div style="
                        font-size:9px;
                        font-weight:bold;
                        line-height:1.1;
                        width:100%;
                        max-width:100%;
                        white-space:normal;
                        overflow-wrap:break-word;
                        word-wrap:break-word;
                        word-break:normal;
                        padding-right:1.5mm;
                        box-sizing:border-box;
                    ">
                        <span t-field="employee.department_id.name"/>
                    </div>

                </div>




                <!-- EXPIRY DATE -->

                <div style="
                    margin:0;
                    padding:0;
                    line-height:1;
                ">

                    <div style="
                        font-size:6.5px;
                        font-weight:normal;
                        margin-bottom:0.6mm;
                    ">
                        د کارت ګڼه / شمیره:
                    </div>

                    <div style="
                        font-size:8.5px;
                        font-weight:bold;
                        line-height:1.1;
                    ">
                        <span t-field="employee.identification_expiry_date"/>
                    </div>

                </div>

            </td>

        </tr>

    </table>

</div>
                        <!--                End of the first Page. -->

                        <!-- ========================================================= -->
<!-- START OF SECOND PAGE - ARCS EMPLOYEE CARD BACK           -->
<!-- ========================================================= -->

<div style="
    position:relative;
    width:85.6mm;
    height:54mm;
    margin:0;
