    <!-- ===================================================== -->
    <!-- PASHTO/DARI EXPIRY DATE VALUE                         -->
    <!-- ===================================================== -->

    <div style="
        position:absolute;
        top:17.4mm;
        right:6mm;
        width:35mm;
        font-size:9px;
        font-weight:normal;
        color:#000;
        text-align:right;
        direction:rtl;
        line-height:4mm;
        white-space:nowrap;
        z-index:10;
    ">
        <span t-field="employee.identification_expiry_date"/>
    </div>


    <!-- ===================================================== -->
    <!-- CENTER FIXED PASHTO TEXT                              -->
    <!-- ===================================================== -->

    <div style="
        position:absolute;
        top:23.0mm;
        left:8mm;
        width:69.6mm;
        font-size:8px;
        font-weight:bold;
        color:#111;

        direction:rtl;
        line-height:4mm;
        z-index:10;
    ">
        ددې کارت درلودونکی د افغاني سرې میاشتې رسمي کارکوونکی دی؛
    </div>


    <div style="
        position:absolute;
        top:27.0mm;
        left:8mm;
        width:69.6mm;
        font-size:8px;
        font-weight:bold;
        color:#111;

        direction:rtl;
        line-height:4mm;
        z-index:10;
    ">
        له اړوندو ادارو هیله کیږي؛ چې د اړتیا پر مهال ورسره مرسته وکړي.
    </div>








    <!-- ===================================================== -->
    <!-- QR CODE                                               -->
    <!-- ===================================================== -->

    <t t-if="employee.qr_code">

        <div style="
            position:absolute;
            top:37.2mm;
            right:6.5mm;
            width:14.5mm;
            height:14.5mm;
            z-index:10;
            overflow:hidden;
        ">

            <img
                t-att-src="
                    '/web/image/hr.employee/'
                    + str(employee.id)
                    + '/qr_code'
                "
                style="
                    width:14.5mm;
                    height:14.5mm;
                    margin:0;
                    padding:0;
                    display:block;
                    border:0;
                "
            />

        </div>

    </t>


    <!-- ===================================================== -->
    <!-- BOTTOM RED BORDER                                    -->
    <!-- ===================================================== -->

    <div style="
        position:absolute;
        bottom:0;
        left:0;
        width:85.6mm;
        height:2mm;
        background:#d00000;
        z-index:5;
    "></div>


</div>

<!-- ========================================================= -->
<!-- END OF SECOND PAGE                                       -->
<!-- ========================================================= -->

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>