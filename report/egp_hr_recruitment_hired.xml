<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="egp_hr_recruitment_hired">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <div class="page" style="font-family:Calibri;">
                        <!-- Table for Applicant Information -->
                        <table class="table table-bordered"
                               style="width: 100%; border-collapse: collapse; margin-top: 20px;">


                            <t t-set="displayed_stage" t-value="false"/>
                            <t t-foreach="docs" t-as="doc">
                                <tr t-if="doc.stage_id.sequence == 4 and not displayed_stage">
                                    <td colspan="12"
                                        style="text-align: center; font-weight: bold; padding: 10px; border: none;">
                                        List of the
                                        <t t-esc="doc.stage_id.name"/>
                                        of the applicants
                                    </td>
                                    <t t-set="displayed_stage" t-value="true"/>
                                </tr>
                            </t>


                            <tr>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">No.</th>
                                <th colspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">Name
                                </th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">F/Name</th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">Phone#</th>
                                <th colspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">
                                    Position Title
                                </th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">Written Test
                                    Marks
                                </th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">Interview
                                    Marks
                                </th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">Total
                                    Marks
                                </th>
                                <th colspan="2"
                                    style="padding: 8px; text-align: center; border: 1px solid #000;  width:500px;">
                                    Notes
                                </th>
                            </tr>
                            <!-- Applicant Data Rows -->
                            <t t-set="position_no" t-value="1"/>
                            <t t-foreach="docs" t-as="doc">
                                <t t-if="doc.sequence_number == 5">
                                    <tr>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="position_no"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.partner_name"/>
                                        </td>
                                        <td colspan="2"
                                            style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.father_name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.partner_phone"/>
                                        </td>
                                        <td colspan="2"
                                            style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.job_id.name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.written_test_marks"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.interview_marks"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.total_marks"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.comment"/>
                                        </td>
                                    </tr>
                                    <t t-set="position_no" t-value="position_no + 1"/>
                                </t>
                            </t>
                        </table>

                        <!-- Committee Section -->
                        <t t-if="docs and docs[0].committee_team_id and docs[0].committee_team_id.member_ids">
                            <h4 class="text-center" style="margin-top: 20px;">Committee Members</h4>
                            <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Number
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Member Name
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Role in committee
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Position
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; width: 100px; background-color: #D3D3D3;">
                                        Sign
                                    </th>
                                </tr>

                                <t t-set="index" t-value="1"/>
                                <t t-foreach="docs[0].committee_team_id.member_ids" t-as="member">
                                    <tr>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="index"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-if="member.agent_type == 'employee'">
                                                <t t-esc="member.employee_id.name"/>
                                            </t>
                                            <t t-if="member.agent_type == 'external'">
                                                <t t-esc="member.agent_name"/>
                                            </t>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="member.tag.name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="member.agent_position_title"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                        </td>

                                    </tr>
                                    <t t-set="index" t-value="index+1"/>
                                </t>
                            </table>
                        </t>

                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>