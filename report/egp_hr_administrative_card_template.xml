<odoo>

    <template id="administrative_employee_card">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="employee">

                <t t-call="web.basic_layout">

                    <!-- ========================================= -->
                    <!-- PAGE 1: FRONT SIDE                         -->
                    <!-- ========================================= -->


                    <div class="page" style="
    page-break-after:always !important;
    width:165mm;
    height:105mm;
    margin:0;
    padding:0;
    position:relative;
">

    <div style="
        position:relative;
        width:165mm;
        height:105mm;
        overflow:hidden;
        margin:0;
        padding:0;
    ">

        <!-- FRONT BACKGROUND -->

        <img
            src="/egp_hr_recruitment/static/img/court_employee_administrative_card.png"
            style="
                position:absolute;
                top:0;
                left:0;
                width:165mm;
                height:105mm;
                z-index:0;
            "
        />

        <!-- FRONT MAIN TABLE -->

        <table style="
            position:absolute;
            top:29.2mm;
            left:1.9mm;
            z-index:10;
            width:159.2mm;
            margin:0;
            padding:0;
            border:0;
            border-collapse:collapse;
            font-size:21.4px;
            font-family:'Calibri',Arial,sans-serif;
            direction:ltr;
        ">

            <tr>

                <!-- EMPLOYEE PHOTO -->

                <td style="
                    width:48.5mm;
                    padding:0;
                    margin:0;
                    vertical-align:middle;
                ">

                    <t t-if="employee.avatar_1920">

                        <img
                            t-att-src="image_data_uri(employee.avatar_1920)"
                            style="
                                width:35mm;
                                height:40.7mm;
                                display:block;
                                margin-top:-9.7mm;
                                padding:0;
                                border:2px solid #000;
                                border-radius:50%;
                                object-fit:cover;
                                box-sizing:border-box;
                            "
                            alt="Employee Photo"
                        />

                    </t>

                </td>

                <!-- EMPLOYEE INFORMATION -->

                <td style="
                    width:97mm;
                    padding:0;
                    margin:0;
                    vertical-align:middle;
                ">

                    <table style="
                        width:100%;
                        border:none;
                        font-size:21.4px;
                        font-family:'Calibri',Arial,sans-serif;
                        direction:rtl;
                        border-collapse:collapse;
                    ">

                        <!-- NAME -->

                        <tr>
                            <td style="
                                font-weight:bold;
                                width:35mm;
                                padding:1.94mm;
                            ">
                                نوم او تخلص:
                            </td>

                            <td style="padding:1.94mm;">
                                <span t-field="employee.name"/>
                            </td>
                        </tr>

                        <!-- FATHER NAME -->

                        <tr>
                            <td style="
                                font-weight:bold;
                                padding:1.94mm;
                            ">
                                د پلار نوم:
                            </td>

                            <td style="padding:1.94mm;">
                                <span t-field="employee.father_name"/>
                            </td>
                        </tr>

                        <!-- JOB -->

                        <tr>
                            <td style="
                                font-weight:bold;
                                padding:1.94mm;
                            ">
                                دنده:
                            </td>

                            <td style="padding:1.94mm;">
                                <span t-field="employee.job_id.name"/>
                            </td>
                        </tr>

                        <!-- ISSUE DATE -->

                        <tr>
                            <td style="
                                font-weight:bold;
                                padding:1.94mm;
                            ">
                                د صدور نیټه:
                            </td>

                            <td style="padding:1.94mm;">
                                <span t-field="employee.identification_print_date"/>
                            </td>
                        </tr>

                        <!-- EXPIRY DATE -->

                        <tr>
                            <td style="
                                font-weight:bold;
                                padding:1.94mm;
                            ">
                                د پای ته رسیدو نیټه:
                            </td>

                            <td style="padding:1.94mm;">
                                <span t-field="employee.identification_expiry_date"/>
                            </td>
                        </tr>

                    </table>

                </td>

            </tr>

        </table>

    </div>

</div>


                    <!-- ========================================= -->
                    <!-- PAGE 2: BACK SIDE                           -->
                    <!-- ========================================= -->

                    <div class="page" style="
    page-break-after:always !important;
    width:165mm;
    height:105mm;
    margin:0;
    padding:0;
">

    <div style="
        position:relative;
        width:165mm;
        height:105mm;
        overflow:hidden;
        margin:0;
        padding:0;
    ">

        <!-- BACKGROUND IMAGE -->

        <img
            src="/egp_hr_recruitment/static/img/court_employee_administrative_card_2.png"
            style="
                position:absolute;
                top:0;
                left:0;
                width:165mm;
                height:105mm;
                z-index:0;
            "
        />

        <!-- BACK MAIN TABLE -->

        <table style="
            position:absolute;
            top:31.1mm;
            left:11.65mm;
            z-index:10;
            width:145.6mm;
            border-collapse:collapse;
            table-layout:fixed;
            font-size:17.5px;
            font-family:Calibri,Arial,sans-serif;
            text-align:left;
            direction:ltr;
            margin:0;
            padding:0;
            border:0.485mm solid #000;
            line-height:1;
        ">

            <!-- TOP SECTION -->

            <tr>

                <!-- LEFT SIDE -->

                <td style="
                    width:65%;
                    padding:0;
                    margin:0;
                    vertical-align:top;
                    border-right:0.485mm solid #000;
                    line-height:1;
                ">

                    <table style="
                        width:100%;
                        border-collapse:collapse;
                        table-layout:fixed;
                        margin:0;
                        padding:0;
                        line-height:1;
                    ">

                        <!-- NAME -->

                        <tr>

                            <td style="
                                width:35mm;
                                height:8.73mm;
                                padding:0.97mm;
                                text-align:left;
                                vertical-align:middle;
                                white-space:nowrap;
                                line-height:1;
                                border-bottom:0.485mm solid #000;
                            ">
                                Name:
                            </td>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                text-align:left;
                                vertical-align:middle;
                                white-space:nowrap;
                                line-height:1;
                                border-bottom:0.485mm solid #000;
                            ">
                                <span t-field="employee.english_name"/>
                            </td>

                        </tr>

                        <!-- FATHER NAME -->

                        <tr>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                border-right:0.485mm solid #000;
                                border-bottom:0.485mm solid #000;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                Father Name:
                            </td>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                border-bottom:0.485mm solid #000;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                <span t-field="employee.english_father_name"/>
                            </td>

                        </tr>

                        <!-- POSITION -->

                        <tr>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                border-right:0.485mm solid #000;
                                border-bottom:0.485mm solid #000;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                Position:
                            </td>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                border-bottom:0.485mm solid #000;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                <span t-field="employee.english_job_position"/>
                            </td>

                        </tr>

                        <!-- ISSUE DATE -->

                        <tr>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                border-right:0.485mm solid #000;
                                border-bottom:0.485mm solid #000;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                Issue Date:
                            </td>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                border-bottom:0.485mm solid #000;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                <span t-field="employee.identification_print_date"/>
                            </td>

                        </tr>

                        <!-- EXPIRY DATE -->

                        <tr>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                border-right:0.485mm solid #000;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                Exp Date:
                            </td>

                            <td style="
                                height:8.73mm;
                                padding:0.97mm;
                                white-space:nowrap;
                                vertical-align:middle;
                                line-height:1;
                            ">
                                <span t-field="employee.identification_expiry_date"/>
                            </td>

                        </tr>

                    </table>

                </td>

                <!-- RIGHT SIDE: QR CODE -->

                <td style="
                    width:35%;
                    height:29.1mm;
                    padding:0;
                    margin:0;
                    text-align:right;
                    vertical-align:middle;
                ">

                    <t t-if="employee.qr_code">

                        <div style="
                            width:38.8mm;
                            height:38.8mm;
                            margin-top:-7.76mm;
                            padding:0;
                            overflow:hidden;
                            position:relative;
                            float:right;
                            text-align:right;
                        ">

                            <img
                                t-att-src="'/web/image/hr.employee/' + str(employee.id) + '/qr_code'"
                                style="
                                    width:29.1mm;
                                    height:29.1mm;
                                    max-width:none;
                                    display:block;
                                    margin:0;
                                    padding:0;
                                    border:0;
                                    float:right;
                                    text-align:right;
                                "
                            />

                        </div>

                    </t>

                </td>

            </tr>

            <!-- BOTTOM SECTION -->

            <tr>

                <td colspan="2" style="
                    padding:0;
                    margin:0;
                    border-top:0.485mm solid #000;
                    line-height:1;
                ">

                    <table style="
                        width:100%;
                        border-collapse:collapse;
                        table-layout:fixed;
                        margin:0;
                        padding:0;
                        line-height:1;
                    ">

                        <tr>

                            <!-- COLUMN 1 -->

                            <td style="
                                width:20%;
                                height:27.2mm;
                                padding:0.97mm;
                                border-right:0.485mm solid #000;
                                vertical-align:middle;
                            ">
                                S.Phone:
                            </td>

                            <!-- COLUMN 2 -->

                            <td style="
                                width:32%;
                                height:7.76mm;
                                padding:0.97mm;
                                border-right:0.485mm solid #000;
                                vertical-align:middle;
                            ">
                            </td>

                            <!-- COLUMN 3 -->

                            <td style="
                                width:21%;
                                height:7.76mm;
                                padding:0.97mm;
                                border-right:0.485mm solid #000;
                                vertical-align:middle;
                            ">
                                Office:
                            </td>

                            <!-- COLUMN 4 -->

                            <td style="
                                width:27%;
                                height:7.76mm;
                                padding:0.97mm;
                                vertical-align:middle;
                            ">
                            </td>

                        </tr>

                    </table>

                </td>

            </tr>

        </table>

    </div>

</div>

                </t>

            </t>

        </t>

    </template>

</odoo>
