<odoo>

    <template id="administrative_employee_card">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="employee">

                <t t-call="web.basic_layout">

                    <div class="page">

                        <div style="
                    position:relative;
                    width:85.6mm;
                    height:54mm;
                    overflow:hidden;
                ">


                            <!-- ========================================= -->
                            <!-- BACKGROUND IMAGE                            -->
                            <!-- ========================================= -->

                            <img
                                    src="/egp_hr_recruitment/static/img/court_employee_administrative_card.png"
                                    style="
                            position:absolute;
                            top:0;
                            left:0;
                            width:85.6mm;
                            height:54mm;
                            z-index:0;
                        "
                            />


                            <!-- ========================================= -->
                            <!-- MAIN TABLE                                  -->
                            <!-- ========================================= -->

                            <table style="
    position:absolute;
    top:15mm;
    left:1mm;
    z-index:10;
    width:82mm;
    margin:0;
    padding:0;
    border:0;
    border-collapse:collapse;
    font-size:11px;
    font-family:'Calibri', Arial, sans-serif;
    direction:ltr;

">

                                <tr>

                                    <!-- ================================= -->
                                    <!-- EMPLOYEE PHOTO - LEFT SIDE        -->
                                    <!-- ================================= -->

                                    <td style="
                                width:25mm;
                                padding:0;
                                margin:0;


                                vertical-align:middle;
                            ">

                                        <t t-if="employee.avatar_1920">

                                            <img
                                                    t-att-src="image_data_uri(employee.avatar_1920)"
                                                    style="
                width:18mm;
                height:21mm;
                display:block;
                margin-top:-5mm;
                padding:0;
                border:1px solid #000;
                border-radius:50%;
                object-fit:cover;
                box-sizing:border-box;

            "
                                                    alt="Employee Photo"
                                            />

                                        </t>

                                    </td>


                                    <!-- ================================= -->
                                    <!-- EMPLOYEE INFORMATION - RIGHT      -->
                                    <!-- ================================= -->

                                    <td style="
                                width:50mm;
                                padding:0;
                                margin:0;
                                vertical-align:middle;
                            ">

                                        <table style="
                                    width:100%;
                                    border:none;
                                    font-size:11px;
                                    font-family:'Calibri', Arial, sans-serif;
                                    direction:rtl;
                                ">


                                            <!-- NAME -->

                                            <tr>

                                                <td style="
                                            font-weight:bold;
                                            width:18mm;
                                            padding:1mm;
                                            font-family:Calibri, Arial, sans-serif;
                                        ">
                                                    نوم او تخلص:
                                                </td>

                                                <td style="
                                            padding:1mm;
                                        ">
                                                    <span t-field="employee.name"/>
                                                </td>

                                            </tr>


                                            <!-- FATHER NAME -->

                                            <tr>

                                                <td style="
                                            font-weight:bold;
                                            padding:1mm;
                                        ">
                                                    د پلار نوم:
                                                </td>

                                                <td style="
                                            padding:1mm;
                                        ">
                                                    <span t-field="employee.father_name"/>
                                                </td>

                                            </tr>


                                            <!-- JOB -->

                                            <tr>

                                                <td style="
                                            font-weight:bold;
                                            padding:1mm;
                                        ">
                                                    دنده:
                                                </td>

                                                <td style="
                                            padding:1mm;
                                        ">
                                                    <span t-field="employee.job_id.name"/>
                                                </td>

                                            </tr>


                                            <!-- ISSUE DATE -->

                                            <tr>

                                                <td style="
                                            font-weight:bold;
                                            padding:1mm;
                                        ">
                                                    د صدور نیټه:
                                                </td>

                                                <td style="
                                            padding:1mm;
                                        ">
                                                    <span t-field="employee.identification_print_date"/>
                                                </td>

                                            </tr>


                                            <!-- EXPIRY DATE -->

                                            <tr>

                                                <td style="
                                            font-weight:bold;
                                            padding:1mm;
                                        ">
                                                    د پای ته رسیدو نیټه:
                                                </td>

                                                <td style="
                                            padding:1mm;
                                        ">
                                                    <span t-field="employee.identification_expiry_date"/>
                                                </td>

                                            </tr>


                                        </table>

                                    </td>

                                </tr>

                            </table>

                        </div>

                        <!--       End of the First Page. -->

                        <div style="margin-top:20mm;
                    position:relative;
                    width:85.6mm;
                    height:54mm;
                    overflow:hidden;
                ">

                            <!-- ================================= -->
                            <!-- BACKGROUND IMAGE                    -->
                            <!-- ================================= -->

                            <img
                                    src="/egp_hr_recruitment/static/img/court_employee_administrative_card_2.png"
                                    style="
                            position:absolute;
                            top:0;
                            left:0;
                            width:85.6mm;
                            height:54mm;
                            z-index:0;
                        "
                            />


                            <!-- ================================= -->
                            <!-- MAIN TABLE                          -->
                            <!-- ================================= -->

                            <table style="
                        position:absolute;
                        top:16mm;
                        left:6mm;
                        z-index:10;
                        width:75mm;
                        border-collapse:collapse;
                        table-layout:fixed;
                        font-size:9px;
                        font-family:Calibri, Arial, sans-serif;
                        text-align:left;
                        direction:ltr;
                        margin:0;
                        padding:0;
                        border:0.25mm solid #000;
                        line-height:1;
                    ">


                                <!-- ================================= -->
                                <!-- TOP SECTION                         -->
                                <!-- LEFT = 2 COLUMNS / 5 ROWS          -->
                                <!-- RIGHT = QR CODE / 1 LARGE CELL      -->
                                <!-- ================================= -->

                                <tr>

                                    <!-- LEFT SIDE -->
                                    <td style="
                                width:65%;
                                padding:0;
                                margin:0;
                                vertical-align:top;
                                border-right:0.25mm solid #000;
                                line-height:1;
                            ">

                                        <table style="
                                    width:100%;
                                    border-collapse:collapse;
                                    table-layout:fixed;
                                    margin:0;
                                    padding:0;
                                    line-height:1;
                                ">

                                            <!-- ===================== -->
                                            <!-- NAME                   -->
                                            <!-- ===================== -->

                                            <tr>

                                                <td style="
                                            width:18mm;
                                            height:4.5mm;
                                            padding:0.5mm;
                                            font-family:Calibri, Arial, sans-serif;
                                            text-align:left;
                                            vertical-align:middle;
                                            white-space:nowrap;
                                            line-height:1;
                                            border-bottom:0.25mm solid #000;
                                        ">
                                                    Name:
                                                </td>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            text-align:left;
                                            vertical-align:middle;
                                            white-space:nowrap;
                                            line-height:1;
                                            border-bottom:0.25mm solid #000;
                                        ">
                                                    <span t-field="employee.english_name"/>
                                                </td>

                                            </tr>


                                            <!-- ===================== -->
                                            <!-- FATHER NAME            -->
                                            <!-- ===================== -->

                                            <tr>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            border-right:0.25mm solid #000;
                                            border-bottom:0.25mm solid #000;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    Father Name:
                                                </td>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            border-bottom:0.25mm solid #000;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    <span t-field="employee.english_father_name"/>
                                                </td>

                                            </tr>


                                            <!-- ===================== -->
                                            <!-- POSITION               -->
                                            <!-- ===================== -->

                                            <tr>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            border-right:0.25mm solid #000;
                                            border-bottom:0.25mm solid #000;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    Position:
                                                </td>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            border-bottom:0.25mm solid #000;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    <span t-field="employee.english_job_position"/>
                                                </td>

                                            </tr>


                                            <!-- ===================== -->
                                            <!-- ISSUE DATE             -->
                                            <!-- ===================== -->

                                            <tr>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            border-right:0.25mm solid #000;
                                            border-bottom:0.25mm solid #000;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    Issue Date:
                                                </td>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            border-bottom:0.25mm solid #000;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    <span t-field="employee.identification_print_date"/>
                                                </td>

                                            </tr>


                                            <!-- ===================== -->
                                            <!-- EXPIRY DATE            -->
                                            <!-- ===================== -->

                                            <tr>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            border-right:0.25mm solid #000;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    Exp Date:
                                                </td>

                                                <td style="
                                            height:4.5mm;
                                            padding:0.5mm;
                                            white-space:nowrap;
                                            vertical-align:middle;
                                            line-height:1;
                                        ">
                                                    <span t-field="employee.identification_expiry_date"/>
                                                </td>

                                            </tr>

                                        </table>

                                    </td>


                                    <!-- ================================= -->
                                    <!-- RIGHT LARGE QR CODE CELL           -->
                                    <!-- ================================= -->

                                    <td style="
    width:35%;
    height:15mm;
    padding:0;
    margin:0;

    text-align:right;
    vertical-align:middle;
">

                                        <t t-if="employee.qr_code">

                                            <div style="
            width:20mm;
            height:20mm;
            margin-top:-4mm;
            padding:0;
            overflow:hidden;
            position:relative;

            float:right;
            text-align:right;
        ">

                                                <img
                                                        t-att-src="'/web/image/hr.employee/' + str(employee.id) + '/qr_code'"
                                                        style="
                    width:15mm;
                    height:15mm;
                    max-width:none;
                    display:block;
                    margin:0;
                    padding:0;
                    border:0;
                    float:right;
                    text-align:right;
                "
                                                />

                                            </div>

                                        </t>

                                    </td>

                                </tr>


                                <!-- ================================= -->
                                <!-- BOTTOM SECTION                     -->
                                <!-- 4 COLUMNS                           -->
                                <!-- ================================= -->

                                <tr>

                                    <td colspan="2" style="
                                padding:0;
                                margin:0;
                                border-top:0.25mm solid #000;
                                line-height:1;
                            ">

                                        <table style="
                                    width:100%;
                                    border-collapse:collapse;
                                    table-layout:fixed;
                                    margin:0;
                                    padding:0;
                                    line-height:1;
                                ">

                                            <tr style="margin-top:15mm; padding-top:20mm;">

                                                <!-- COLUMN 1 -->
                                                <td style="
                                            width:20%;
                                            height:14mm;
                                            padding:0.5mm;
                                            border-right:0.25mm solid #000;
                                            vertical-align:middle;
                                        ">
                                                    S.Phone:
                                                </td>


                                                <!-- COLUMN 2 -->
                                                <td style="
                                            width:32%;
                                            height:4mm;
                                            padding:0.5mm;
                                            border-right:0.25mm solid #000;
                                            vertical-align:middle;
                                        ">
                                                </td>


                                                <!-- COLUMN 3 -->
                                                <td style="
                                            width:21%;
                                            height:4mm;
                                            padding:0.5mm;
                                            border-right:0.25mm solid #000;
                                            vertical-align:middle;
                                        ">
                                                    Office:
                                                </td>


                                                <!-- COLUMN 4 -->
                                                <td style="
                                            width:27%;
                                            height:4mm;
                                            padding:0.5mm;
                                            vertical-align:middle;
                                        ">
                                                </td>

                                            </tr>

                                        </table>

                                    </td>

                                </tr>

                            </table>

                        </div>
                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>