<odoo>

    <template id="service_employee_card">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="employee">
                <t t-call="web.basic_layout">

                    <!-- ======================================= -->
                    <!-- PAGE 1: FRONT SIDE                      -->
                    <!-- ======================================= -->

                    <div class="page" style="
                        position:relative;
                        width:165mm !important;
                        height:105mm !important;
                        min-height:105mm !important;
                        max-height:105mm !important;
                        margin:0 !important;
                        padding:0 !important;
                        overflow:hidden;
                        page-break-after:always;
                    ">

                        <!-- FRONT BACKGROUND -->

                        <img
                                src="/egp_hr_recruitment/static/img/service_card.png"
                                style="
                                position:absolute;
                                top:0;
                                left:0;
                                width:165mm;
                                height:105mm;
                                margin:0;
                                padding:0;
                                display:block;
                                z-index:0;
                            "
                        />

                        <!-- ======================================= -->
                        <!-- EMPLOYEE PHOTO                          -->
                        <!-- ======================================= -->

                        <t t-if="employee.avatar_1920">

                            <img
                                    t-att-src="image_data_uri(employee.avatar_1920)"
                                    style="
                                    position:absolute;
                                    top:30mm;
                                    left:2mm;
                                    width:35mm;
                                    height:47mm;
                                    display:block;
                                    margin:0;
                                    padding:0;
                                    border:1.5px solid #000;
                                    border-radius:50%;
                                    object-fit:cover;
                                    box-sizing:border-box;
                                    z-index:10;
                                "
                                    alt="Employee Photo"
                            />

                        </t>

                        <!-- ======================================= -->
                        <!-- EMPLOYEE ID BARCODE                     -->
                        <!-- ======================================= -->

                        <t t-if="employee.identification_no">

                            <div style="
                                position:absolute;
                                top:79mm;
                                left:2mm;
                                width:45mm;
                                height:16mm;
                                margin:0;
                                padding:0;
                                background:transparent;
                                text-align:center;
                                z-index:20;
                                overflow:hidden;
                            ">

                                <!-- BARCODE IMAGE -->

                                <img
                                        t-att-src="'/report/barcode/Code128/%s?width=600&amp;height=120&amp;quiet=0' % employee.identification_no"
                                        style="
                                        display:block;
                                        width:45mm;
                                        height:12mm;
                                        margin:0 auto;
                                        padding:0;
                                        border:0;
                                        background:transparent;
                                    "
                                        alt="Employee ID Barcode"
                                />

                                <!-- IDENTIFICATION NUMBER -->

                                <div style="
                                    width:45mm;
                                    height:4mm;
                                    margin:0;
                                    padding:0;
                                    font-family:Arial,sans-serif;
                                    font-size:10pt;
                                    font-weight:bold;
                                    color:#000;
                                    text-align:center;
                                    line-height:4mm;
                                    letter-spacing:0.5px;
                                    background:transparent;
                                ">
                                    <span t-esc="employee.identification_no"/>
                                </div>

                            </div>

                        </t>

                        <!-- ======================================= -->
                        <!-- FRONT EMPLOYEE INFORMATION              -->
                        <!-- ======================================= -->

                        <table style="
                            position:absolute;
                            top:29mm;
                            right:4.5mm;
                            width:117.5mm;
                            margin:0;
                            padding:0;
                            border:0;
                            border-collapse:collapse;
                            table-layout:fixed;
                            font-size:19px;
                            font-family:Calibri,Arial,sans-serif;
                            direction:rtl;
                            line-height:1.4;
                            background:transparent;
                            z-index:10;
                        ">

                            <!-- NAME -->

                            <tr style="height:9mm;">

                                <td style="
                                    width:38mm;
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    font-size:21px;
                                    font-weight:bold;
                                    white-space:nowrap;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    نوم او تخلص:
                                </td>

                                <td style="
                                    width:79.5mm;
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    font-weight:bold;
                                    font-size:21px;
                                    white-space:nowrap;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    <span t-field="employee.name"/>
                                </td>

                            </tr>

                            <!-- FATHER NAME -->

                            <tr style="height:12mm;">

                                <td style="
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    font-weight:bold;
                                    font-size:21px;
                                    white-space:nowrap;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    د پلار نوم:
                                </td>

                                <td style="
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    white-space:nowrap;
                                    font-size:21px;
                                    font-weight:bold;
                                    vertical-align:middle;
                                    line-height:1.3;
                                    background:transparent;
                                    border:none;
                                ">
                                    <span t-field="employee.father_name"/>
                                </td>

                            </tr>

                            <!-- JOB -->

                            <tr style="height:12mm;">

                                <td style="
                                    height:12mm;
                                    margin:0;
                                    padding:0;
                                    font-weight:bold;
                                    font-size:21px;
                                    white-space:nowrap;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    دنده:
                                </td>

                                <td style="
                                    height:12mm;
                                    margin:0;
                                    padding:0;
                                    white-space:normal;
                                    font-weight:bold;
                                    font-size:21px;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    overflow-wrap:break-word;
                                    background:transparent;
                                    border:none;
                                ">
                                    <span t-field="employee.job_id.name"/>
                                </td>

                            </tr>

                            <!-- ISSUE DATE -->

                            <tr style="height:9mm;">

                                <td style="
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    font-weight:bold;
                                    font-size:21px;
                                    white-space:nowrap;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    د صدور نیټه:
                                </td>

                                <td style="
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    white-space:nowrap;
                                    font-weight:bold;
                                    font-size:21px;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    <span t-field="employee.identification_print_date"/>
                                </td>

                            </tr>

                            <!-- EXPIRY DATE -->

                            <tr style="height:9mm;">

                                <td style="
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    font-weight:bold;
                                    font-size:21px;
                                    white-space:nowrap;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    د پای ته رسیدو نیټه:
                                </td>

                                <td style="
                                    height:9mm;
                                    margin:0;
                                    padding:0;
                                    white-space:nowrap;
                                    font-weight:bold;
                                    vertical-align:middle;
                                    line-height:1.4;
                                    background:transparent;
                                    border:none;
                                ">
                                    <span t-field="employee.identification_expiry_date"/>
                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- ======================================= -->
                    <!-- PAGE 2: BACK SIDE                       -->
                    <!-- ======================================= -->

                    <div class="page" style="
                        position:relative;
                        width:165mm !important;
                        height:105mm !important;
                        min-height:105mm !important;
                        max-height:105mm !important;
                        margin:0 !important;
                        padding:0 !important;
                        overflow:hidden;
                        page-break-after:always;
                    ">

                        <div style="
                            position:relative;
                            width:165mm;
                            height:105mm;
                            overflow:hidden;
                        ">

                            <!-- BACKGROUND -->

                            <img
                                    src="/egp_hr_recruitment/static/img/court_employee_service_card_2.png"
                                    style="
                                    position:absolute;
                                    top:0;
                                    left:0;
                                    width:165mm;
                                    height:105mm;
                                    z-index:0;
                                "
                            />

                            <!-- MAIN INFORMATION TABLE -->

                            <table style="
                                position:absolute;
                                top:31.11mm;
                                left:11.57mm;
                                z-index:10;
                                width:144.57mm;
                                border-collapse:collapse;
                                table-layout:fixed;
                                font-size:17.5px;
                                font-family:Calibri,Arial,sans-serif;
                                text-align:left;
                                direction:ltr;
                                margin:0;
                                padding:0;
                                border:none;
                                line-height:1;
                            ">

                                <!-- TOP SECTION -->

                                <tr>

                                    <!-- LEFT INFORMATION SECTION -->

                                    <td style="
                                        width:65%;
                                        padding:0;
                                        margin:0;
                                        vertical-align:top;
                                        border:none;
                                        line-height:1;
                                    ">

                                        <table style="
                                            width:100%;
                                            border-collapse:collapse;
                                            table-layout:fixed;
                                            margin:0;
                                            padding:0;
                                            line-height:1;
                                            border:none;
                                        ">

                                            <!-- NAME -->

                                            <tr>
                                                <td style="
                                                    width:34.70mm;
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    font-family:Calibri,Arial,sans-serif;
                                                    text-align:left;
                                                    vertical-align:middle;
                                                    white-space:nowrap;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    Name:
                                                </td>

                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    text-align:left;
                                                    vertical-align:middle;
                                                    white-space:nowrap;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    <span t-field="employee.english_name"/>
                                                </td>
                                            </tr>

                                            <!-- FATHER NAME -->

                                            <tr>
                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    Father Name:
                                                </td>

                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    <span t-field="employee.english_father_name"/>
                                                </td>
                                            </tr>

                                            <!-- POSITION -->

                                            <tr>
                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    Position:
                                                </td>

                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    <span t-field="employee.english_job_position"/>
                                                </td>
                                            </tr>

                                            <!-- ISSUE DATE -->

                                            <tr>
                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    Issue Date:
                                                </td>

                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    <span t-field="employee.identification_print_date"/>
                                                </td>
                                            </tr>

                                            <!-- EXPIRY DATE -->

                                            <tr>
                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    Exp Date:
                                                </td>

                                                <td style="
                                                    height:8.73mm;
                                                    padding:0.96mm;
                                                    white-space:nowrap;
                                                    vertical-align:middle;
                                                    line-height:1;
                                                    border:none;
                                                ">
                                                    <span t-field="employee.identification_expiry_date"/>
                                                </td>
                                            </tr>

                                        </table>

                                    </td>


                                    <!-- QR CODE SECTION -->

                                    <td style="
                                        width:35%;
                                        height:29.17mm;
                                        padding:0;
                                        margin:0;
                                        text-align:right;
                                        vertical-align:middle;
                                        border:none;
                                    ">

                                        <t t-if="employee.qr_code">

                                            <div style="
                                                width:38.55mm;
                                                height:38.89mm;
                                                margin-top:-7.78mm;
                                                padding:0;
                                                overflow:hidden;
                                                position:relative;
                                                float:right;
                                                text-align:right;
                                            ">

                                                <img
                                                        t-att-src="'/web/image/hr.employee/' + str(employee.id) + '/qr_code'"
                                                        style="
                                                        width:28.91mm;
                                                        height:29.17mm;
                                                        max-width:none;
                                                        display:block;
                                                        margin:0;
                                                        padding:0;
                                                        border:none;
                                                        float:right;
                                                        text-align:right;
                                                    "
                                                />

                                            </div>

                                        </t>

                                    </td>

                                </tr>


                                <!-- BOTTOM SECTION -->

                                <tr>

                                    <td colspan="2" style="
                                        padding:0;
                                        margin:0;
                                        border:none;
                                        line-height:1;
                                    ">

                                        <table style="
                                            width:100%;
                                            border-collapse:collapse;
                                            table-layout:fixed;
                                            margin:0;
                                            padding:0;
                                            line-height:1;
                                            border:none;
                                        ">

                                            <tr style="
                                                margin-top:29.17mm;
                                                padding-top:38.89mm;
                                                border:none;
                                            ">

                                                <!-- S.PHONE LABEL -->

                                                <td style="
                                                    width:20%;
                                                    height:27.22mm;
                                                    padding:0.96mm;
                                                    vertical-align:middle;
                                                    border:none;
                                                ">
                                                    S.Phone:
                                                </td>

                                                <!-- S.PHONE VALUE -->

                                                <td style="
                                                    width:32%;
                                                    height:7.78mm;
                                                    padding:0.96mm;
                                                    vertical-align:middle;
                                                    border:none;
                                                ">
                                                </td>

                                                <!-- OFFICE LABEL -->

                                                <td style="
                                                    width:21%;
                                                    height:7.78mm;
                                                    padding:0.96mm;
                                                    vertical-align:middle;
                                                    border:none;
                                                ">
                                                    Office:
                                                </td>

                                                <!-- OFFICE VALUE -->

                                                <td style="
                                                    width:27%;
                                                    height:7.78mm;
                                                    padding:0.96mm;
                                                    vertical-align:middle;
                                                    border:none;
                                                ">
                                                </td>

                                            </tr>

                                        </table>

                                    </td>

                                </tr>

                            </table>

                        </div>

                    </div>

                </t>
            </t>

        </t>

    </template>

</odoo>
