<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="egp_hr_recruitment_print_long_tree">
            <t t-call="web.html_container">
                <t t-call="web.internal_layout">
                    <t t-set="company" t-value="docs and docs[0].company_id"/>
                    <!--                    <t t-set="company" t-value="docs and docs[0].company_id or False"/>-->
                    <div class="page" style="font-family:Calibri;">
                        <!--                        Ministry Header Section-->
                        <div class="row">
                            <div class="col-6 text-center">
                                <p>امارت اسلامی افغانستان</p>
                                <p>
                                    <t t-esc="company.name"/>
<!--                                    <t t-if="company">-->
<!--                                        <p>-->
<!--                                            <t t-esc="company.name"/>-->
<!--                                        </p>-->
<!--                                    </t>-->
                                </p>
                            </div>
                            
                            <div class="col-6 text-center">
                                <p>د افغانستان اسلامي امارت</p>
                                <p>
                                    <t t-esc="company.name"/>
                                </p>
                            </div>
                        </div>
                        <!-- Logo and Title Section -->
                        <div class="row" style="margin-top:15px;">
                            <div class="col-2" style="margin-left: 10px; margin-top: 10px;">
                                <img src="egp_hr_recruitment/static/description/MCIT_logo.png" height="150"
                                     width="200"/>
                            </div>
                            <div class="col-8 text-center">
                                <p>Islamic Emirate of Afghanistan</p>
                                <p>
                                    <t t-esc="company.name"/>
                                </p>
                                <p>Human Resource Department</p>
                                <p>Recruitment Office</p>
                                <p>Stages of Applicant</p>
                            </div>
                            <div class="col-2">
                                <img src="egp_hr_recruitment/static/description/eia.png" height="100" width="100"
                                     style="margin-top: 10px;"/>
                            </div>
                        </div>

                        <!-- Table for Applicant Information -->
                        <table class="table table-bordered"
                               style="width: 100%; border-collapse: collapse; margin-top: 20px;">
                            <t t-set="message_displayed" t-value="False"/>
                            <t t-foreach="docs" t-as="doc">
                                <tr t-if="doc.stage_id.sequence == 1 and not message_displayed">
                                    <td colspan="14"
                                        style="text-align:center; font-weight: bold; padding: 10px; border: none;">
                                        The
                                        <t t-esc="doc.stage_id.name"/>
                                        applicants List.
                                    </td>
                                    <t t-set="message_displayed" t-value="True"/>
                                </tr>
                            </t>

                            <tr>
                                <th colspan="4">Ministry:
                                    <t t-if="docs and docs[0]">
                                        <t t-esc="docs[0].company_id.name"/>
                                    </t>
                                </th>
                                <th colspan="7">
                                    <t t-if="docs">
                                        <t t-esc="docs[0].name"/>
                                    </t>
                                </th>


                                <th colspan="3">Date: 144 / /</th>
                            </tr>

                            <!--Table Headers for Applicant Details-->
                            <tr>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">Num
                                </th>
                                <th colspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">
                                    Applicant Details
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">
                                    Email
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">
                                    Phone
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">
                                    Degree
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">
                                    Faculty
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">
                                    Gender
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">Type
                                    of Application
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">Native
                                    Language
                                </th>
                                <th rowspan="2" style="padding: 8px; text-align: center; border: 1px solid #000;">Total
                                    Years of Experience
                                </th>
                                <th rowspan="2" colspan="2"
                                    style="padding: 8px; text-align: center; border:1px solid #000;width :500px;">
                                    Notes
                                </th>
                            </tr>
                            <tr>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">Name</th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #000;">Father's Name</th>
                            </tr>

                            <!-- Applicant Data Rows -->
                            <t t-set="position_no" t-value="1"/>
                            <t t-foreach="docs" t-as="doc">
                                <t t-if="doc.sequence_number == 1">
                                    <tr>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="position_no"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.partner_name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.father_name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.email_from"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.partner_phone"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.type_id.name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.applicant_faculty_name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.gender"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.type_of_application"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.get_native_language_display()"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.total_years_experience"/>
                                        </td>
                                        <td colspan="2"
                                            style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="doc.comment"/>
                                        </td>
                                        <!--                                    <td style="padding: 8px; text-align: center; border: 1px solid #000;">-->
                                        <!--                                        &lt;!&ndash; Placeholder for notes if applicable &ndash;&gt;-->
                                        <!--                                    </td>-->
                                    </tr>
                                    <t t-set="position_no" t-value="position_no + 1"/>
                                </t>
                            </t>
                        </table>

                        <!--                        &lt;!&ndash;                                                 Committee Section &ndash;&gt;-->
                        <t t-if="docs and docs[0].committee_team_id and docs[0].committee_team_id.member_ids">
                            <h4 class="text-center" style="margin-top: 20px;">Committee Members</h4>
                            <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Number
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Member Name
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Role in committee
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; background-color: #D3D3D3;">
                                        Position
                                    </th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid #000; width: 100px; background-color: #D3D3D3;">
                                        Sign
                                    </th>
                                </tr>

                                <t t-set="index" t-value="1"/>
                                <t t-foreach="docs[0].committee_team_id.member_ids" t-as="member">
                                    <tr>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="index"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-if="member.agent_type == 'employee'">
                                                <t t-esc="member.employee_id.name"/>
                                            </t>
                                            <t t-if="member.agent_type == 'external'">
                                                <t t-esc="member.agent_name"/>
                                            </t>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="member.tag.name"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                            <t t-esc="member.agent_position_title"/>
                                        </td>
                                        <td style="padding: 8px; text-align: center; border: 1px solid #000;">
                                        </td>

                                    </tr>
                                    <t t-set="index" t-value="index+1"/>

                                </t>

                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>

</odoo>




