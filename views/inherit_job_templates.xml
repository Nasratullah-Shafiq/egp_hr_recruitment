<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit the job detail template and add layiha wazayif when click on each job details -->
    <template id="custom_job_detail"
              name="Custom Job Detail"
              inherit_id="website_hr_recruitment.detail"
              priority="99">

        <xpath expr="//div[@t-field='job.website_description']" position="replace">

            <!-- Add container with margin -->
            <div class="container py-4">
                <div class="row justify-content-center">
                    <div class="col-12">

                        <div class="card shadow-sm border-0 rounded-3 mb-4">
                            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                                <div class="d-flex align-items-center">
                                    <div class="flex-shrink-0">
                                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                                            <i class="fa fa-file-text-o text-primary fs-4"></i>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h4 class="mb-0">Job Description</h4>
                                        <p class="text-muted mb-0 small">Detailed responsibilities and requirements</p>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body p-4">
                                <t t-set="full_text" t-value="job.custom_job_description or ''"/>
                                <t t-set="short_text" t-value="full_text[:500]"/>

                                <div class="custom_job_description_container">
                                    <!-- Short Text -->
                                    <div class="short-text text-muted" style="line-height: 1.6;">
                                        <t t-esc="short_text"/>
                                        <t t-if="len(full_text) > 500">...</t>
                                    </div>

                                    <!-- Full Text -->
                                    <div class="full-text d-none text-muted" style="line-height: 1.6;">
                                        <t t-esc="full_text"/>
                                    </div>

                                    <!-- Button -->
                                    <t t-if="len(full_text) > 500">
                                        <div class="mt-3">
                                            <a href="javascript:void(0);" class="see-more-btn text-decoration-none">
                                                <i class="fa fa-chevron-circle-down me-1"></i>
                                                See more
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </xpath>
    </template>

    <!-- remove the static data and add my own custom_job_description(layiha wazayif) field data -->
    <template id="custom_job_index"
              name="Custom Job Index"
              inherit_id="website_hr_recruitment.index"
              priority="99">

        <xpath expr="//div[@t-field='job.description']" position="replace">
            <div class="custom_job_description_container mb16">
                <t t-set="full_text" t-value="job.custom_job_description or ''"/>
                <t t-set="short_text" t-value="full_text[:500]"/>

                <!-- Short Text -->
                <div class="short-text oe_text_muted">
                    <t t-esc="short_text"/>
                    <t t-if="len(full_text) > 500">...</t>
                </div>

                <!-- Full Text -->
                <div class="full-text d-none oe_text_muted">
                    <t t-esc="full_text"/>
                </div>

                <!-- Buttons Container -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <div>
                        <t t-if="len(full_text) > 500">
                            <a href="javascript:void(0);" class="see-more-btn text-primary">
                                See more
                            </a>
                        </t>
                    </div>
                    <div class="float-end">
                        <a role="button" t-attf-href="/jobs/apply/#{slug(job)}"
                           class="btn btn-primary btn-lg float-end">Apply Now!
                            <i class="fa fa-arrow-right ms-1"></i>
                        </a>

                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="custom_job_right_side_bar"
              name="Custom Job Right Side Bar"
              inherit_id="website_hr_recruitment.job_right_side_bar"
              priority="99">

        <!-- First, make the company variable available in the context -->
        <xpath expr="//div[@id='jobs_grid_right']" position="before">
            <t t-set="company" t-value="request.env.company"/>
        </xpath>

        <!-- Replace the entire section content -->
        <xpath expr="//div[@id='jobs_grid_right']//section" position="replace">
            <section class="custom-sidebar-section">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12 pb24">

                            <!-- Custom Image -->
                            <img src="/egp_hr_recruitment/static/img/mcit_bg.jpg"
                                 class="img-fluid rounded shadow-sm mb-3"
                                 alt="Company Building"/>

                            <!-- Dynamic Company Name and Description -->
                            <div class="custom-description mt24 mb8">
                                <h5 class="text-primary mb-3">
                                    About
                                    <span t-esc="company.display_name"/>
                                </h5>

                                <p class="mb-3" t-if="company.about">
                                    <t t-esc="company.about" t-options="{'widget': 'html', 'sanitize': False}"/>
                                </p>

                                <!-- If the about field is empty, default message -->
                                <p class="text-muted" t-else="company.about">
                                    This company has not yet added a description.
                                </p>


                                <p class="mb-3">
                                    <strong>Why join<span t-esc="company.display_name"/>?
                                    </strong>
                                </p>
                                <ul class="mb-3">
                                    <li>Work on impactful projects</li>
                                    <li>Collaborative work environment</li>
                                    <li>Competitive compensation and benefits</li>
                                    <li>Professional development opportunities</li>
                                </ul>
                            </div>

                            <!-- Separator -->
                            <div class="s_hr text-start pt16 pb16" data-snippet="s_hr" data-name="Separator">
                                <hr class="w-100 mx-auto"
                                    style="border-top-width: 2px; border-top-style: solid; border-top-color: #00A9E0 !important;"/>
                            </div>

                            <!-- Dynamic Contact Information -->
                            <div id="connect">
                                <h5 class="mb-3">Contact Us</h5>
                                <ul class="list-unstyled text-nowrap">
                                    <li t-if="company.phone" class="mb-2">
                                        <i class="fa fa-phone fa-fw me-2 text-primary"></i>
                                        <span class="o_force_ltr">
                                            <a t-att-href="'tel:' + company.phone" t-esc="company.phone"/>
                                        </span>
                                    </li>
                                    <li t-if="company.email" class="mb-2">
                                        <i class="fa fa-envelope fa-fw me-2 text-primary"></i>
                                        <span>
                                            <a t-att-href="'mailto:' + company.email" t-esc="company.email"/>
                                        </span>
                                    </li>
                                    <li t-if="company.website" class="mb-2">
                                        <i class="fa fa-globe fa-fw me-2 text-primary"></i>
                                        <span>
                                            <a t-att-href="company.website" target="_blank"
                                               t-esc="company.website"/>
                                        </span>
                                    </li>
                                    <li t-if="company.street" class="mb-2">
                                        <i class="fa fa-map-marker fa-fw me-2 text-primary"></i>
                                        <span>
                                            <t t-if="company.street"><t t-esc="company.street"/>,
                                            </t>
                                            <t t-if="company.city"><t t-esc="company.city"/>,
                                            </t>
                                            <t t-if="company.country_id">
                                                <t t-esc="company.country_id.name"/>
                                            </t>
                                        </span>
                                    </li>
                                </ul>

                                <!-- Dynamic Social Media Links from Company -->
                                <div class="s_social_media mt-4">
                                    <h5 class="mb-3">Follow Us</h5>
                                    <br/>

                                    <t t-if="company.social_facebook">
                                        <a t-att-href="company.social_facebook"
                                           target="_blank"
                                           class="btn btn-outline-primary rounded-circle me-2 mb-2"
                                           aria-label="Facebook">
                                            <i class="fa fa-facebook"/>
                                        </a>
                                    </t>

                                    <t t-if="company.social_twitter">
                                        <a t-att-href="company.social_twitter"
                                           target="_blank"
                                           class="btn btn-outline-primary rounded-circle me-2 mb-2"
                                           aria-label="Twitter">
                                            <i class="fa fa-twitter"/>
                                        </a>
                                    </t>

                                    <t t-if="company.social_linkedin">
                                        <a t-att-href="company.social_linkedin"
                                           target="_blank"
                                           class="btn btn-outline-primary rounded-circle me-2 mb-2"
                                           aria-label="LinkedIn">
                                            <i class="fa fa-linkedin"/>
                                        </a>
                                    </t>

                                    <t t-if="company.social_youtube">
                                        <a t-att-href="company.social_youtube"
                                           target="_blank"
                                           class="btn btn-outline-danger rounded-circle me-2 mb-2"
                                           aria-label="YouTube">
                                            <i class="fa fa-youtube"/>
                                        </a>
                                    </t>

                                    <t t-if="company.social_github">
                                        <a t-att-href="company.social_github"
                                           target="_blank"
                                           class="btn btn-outline-secondary rounded-circle me-2 mb-2"
                                           aria-label="GitHub">
                                            <i class="fa fa-github"/>
                                        </a>
                                    </t>

                                    <t t-if="company.social_instagram">
                                        <a t-att-href="company.social_instagram"
                                           target="_blank"
                                           class="btn btn-outline-danger rounded-circle me-2 mb-2"
                                           aria-label="Instagram">
                                            <i class="fa fa-instagram"/>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>

        <!-- Add custom CSS for better styling -->
        <xpath expr="//div[@id='jobs_grid_right']" position="inside">
            <style type="text/css">
                .custom-sidebar-section {
                background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
                border-radius: 15px;
                padding: 20px;
                margin-bottom: 20px;
                box-shadow: 0 5px 15px rgba(0,0,0,0.08);
                }
                .custom-sidebar-section h5 {
                color: #00A9E0;
                font-weight: 600;
                }
                .custom-sidebar-section .btn-outline-primary {
                border-radius: 50%;
                width: 40px;
                height: 40px;
                padding: 8px 0;
                transition: all 0.3s ease;
                }
                .custom-sidebar-section .btn-outline-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 10px rgba(0,0,0,0.1);
                }
                .custom-sidebar-section .fa {
                font-size: 18px;
                }
                .custom-sidebar-section ul li {
                margin-bottom: 12px;
                }
                .custom-sidebar-section a {
                color: #00A9E0;
                text-decoration: none;
                }
                .custom-sidebar-section a:hover {
                text-decoration: underline;
                }
            </style>
        </xpath>

    </template>
    <!--Remove Odoo default company phone number and add dynamic company phone number -->
    <template id="custom_website_header_phone"
              name="Custom Website Header Phone"
              inherit_id="website.header_text_element"
              priority="99">

        <xpath expr="." position="replace">
            <t t-set="company" t-value="website.company_id"/>
            <!-- DEFINE company -->
            <li>
                <i class="fa fa-phone me-2"/>
                <a t-if="company.phone"
                   t-att-href="'tel:%s' % company.phone.replace(' ', '')"
                   class="text-black">
                    <t t-esc="company.phone"/>
                </a>
            </li>
        </xpath>
    </template>

</odoo>