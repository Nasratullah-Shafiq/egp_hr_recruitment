<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- TREE VIEW                                              -->
    <!-- ===================================================== -->
    <record id="view_employee_card_tree" model="ir.ui.view">
        <field name="name">hr.employee.card.tree</field>
        <field name="model">hr.employee.card</field>
        <field name="arch" type="xml">
            <tree string="Employee Cards">
                <field name="employee_id"/>
                <field name="father_names"/>
                <field name="grand_father_names"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="category"/>
                <field name="job_status"/>
                <field name="issue_date"/>
                <field name="expire_date"/>
                <field name="card_status"
                       widget="badge"
                       decoration-success="card_status == 'printed'"
                       decoration-danger="card_status == 'expired'"
                       decoration-warning="card_status == 'draft'"
                       decoration-muted="card_status == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- FORM VIEW WITH CHATTER                                 -->
    <!-- ===================================================== -->
    <record id="view_employee_card_form" model="ir.ui.view">
        <field name="name">hr.employee.card.form</field>
        <field name="model">hr.employee.card</field>
        <field name="arch" type="xml">
            <form string="Employee Card">
                <header>
                    <!-- Print Employee Card Button -->
                    <button name="action_print_employee_card"
                            type="object"
                            string="Print Employee Card"
                            class="btn-primary"
                            icon="fa-print"
                            invisible="card_status == 'cancelled'"/>

                    <!-- Print ARCS Employee Card Button -->
                    <button
                            name="action_print_arcs_employee_card"
                            type="object"
                            string="Print Employee Card"
                            class="btn-primary"
                            icon="fa-print"
                            groups="egp_hr.group_arcs_employee_officers"
                    />

                    <!-- Draft Employee Card Button -->
                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            class="btn-warning"
                            confirm="Are you sure you want to reset this cancelled card to draft?"
                            invisible="card_status != 'cancelled'"/>

                    <!-- Cancel Card Button -->
                    <button name="action_cancel_card"
                            type="object"
                            string="Cancel Card"
                            class="btn-danger"
                            confirm="Are you sure you want to cancel this employee card?"
                            invisible="card_status != 'printed'"/>

                    <!-- Status Bar -->
                    <field name="card_status"
                           widget="statusbar"
                           statusbar_visible="draft,printed,cancelled,expired"/>
                </header>
                <sheet>
                    <!-- Draft Ribbon -->
                    <widget name="web_ribbon"
                            title="Draft"
                            bg_color="bg-info"
                            invisible="card_status != 'draft'"/>

                    <!-- Printed Ribbon -->
                    <widget name="web_ribbon"
                            title="Printed"
                            bg_color="bg-success"
                            invisible="card_status != 'printed'"/>

                    <!-- Expired Ribbon -->
                    <widget name="web_ribbon"
                            title="Expired"
                            bg_color="bg-warning"
                            invisible="card_status != 'expired'"/>

                    <!-- Cancelled Ribbon -->
                    <widget name="web_ribbon"
                            title="Cancelled"
                            bg_color="bg-danger"
                            invisible="card_status != 'cancelled'"/>

                    <!-- Employee Name -->
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id"
                                   placeholder="Select Employee"/>
                        </h1>
                    </div>

                    <!-- Employee Information and Photo -->
                    <group string="Employee Information">

                        <group>
                            <field name="father_names"/>
                            <field name="grand_father_names"/>
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="category"/>
                            <field name="identification_no"/>
                            <field name="job_status"/>
                        </group>

                        <group>
                            <field name="employee_photo"
                                   widget="image"
                                   class="oe_avatar"
                                   options="{'size': [300, 300]}"/>
                        </group>

                    </group>

                    <!-- Card Information -->
                    <group string="Card Information">

                        <group>
                            <field name="issue_date"/>
                            <field name="expire_date"/>
                        </group>

                        <group>
                            <field name="card_status"
                                   widget="badge"/>
                        </group>

                    </group>

                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- SEARCH VIEW                                            -->
    <!-- ===================================================== -->
    <record id="view_employee_card_search" model="ir.ui.view">
        <field name="name">hr.employee.card.search</field>
        <field name="model">hr.employee.card</field>
        <field name="arch" type="xml">
            <search string="Search Employee Cards">

                <!-- Search Fields -->
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="job_status"/>
                <field name="card_status"/>

                <!-- Filters -->
                <filter string="Active Cards"
                        name="active_cards"
                        domain="[('card_status', '=', 'active')]"/>

                <filter string="Expired Cards"
                        name="expired_cards"
                        domain="[('card_status', '=', 'expired')]"/>

                <filter string="Draft Cards"
                        name="draft_cards"
                        domain="[('card_status', '=', 'draft')]"/>

                <filter string="Cancelled Cards"
                        name="cancelled_cards"
                        domain="[('card_status', '=', 'cancelled')]"/>

                <separator/>

                <!-- Group By -->
                <group expand="0" string="Group By">

                    <filter string="Employee"
                            name="group_employee"
                            context="{'group_by': 'employee_id'}"/>

                    <filter string="Department"
                            name="group_department"
                            context="{'group_by': 'department_id'}"/>

                    <filter string="Job Position"
                            name="group_job"
                            context="{'group_by': 'job_id'}"/>

                    <filter string="Job Status"
                            name="group_job_status"
                            context="{'group_by': 'job_status'}"/>

                    <filter string="Card Status"
                            name="group_card_status"
                            context="{'group_by': 'card_status'}"/>

                </group>

                <!-- Search Panel -->
                <searchpanel>

                    <field name="card_status"
                           string="Card Status"
                           enable_counters="1"/>

                    <field name="department_id"
                           string="Department"
                           enable_counters="1"/>

                    <field name="job_id"
                           string="Job Position"
                           enable_counters="1"/>

                </searchpanel>

            </search>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- GRAPH VIEW                                             -->
    <!-- ===================================================== -->
    <record id="view_employee_card_graph" model="ir.ui.view">
        <field name="name">hr.employee.card.graph</field>
        <field name="model">hr.employee.card</field>
        <field name="arch" type="xml">
            <graph string="Employee Card Analysis" type="bar">
                <field name="department_id" type="row"/>
                <field name="card_count" type="measure"/>
            </graph>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- PIVOT VIEW                                             -->
    <!-- ===================================================== -->
    <record id="view_employee_card_pivot" model="ir.ui.view">
        <field name="name">hr.employee.card.pivot</field>
        <field name="model">hr.employee.card</field>
        <field name="arch" type="xml">
            <pivot string="Employee Card Analysis">

                <field name="department_id" type="row"/>
                <field name="card_status" type="col"/>
                <field name="card_count" type="measure"/>

            </pivot>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- ACTION                                                 -->
    <!-- ===================================================== -->
    <record id="action_employee_card" model="ir.actions.act_window">
        <field name="name">Employee Cards</field>
        <field name="res_model">hr.employee.card</field>
        <field name="view_mode">tree,form,graph,pivot</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first employee card
            </p>
            <p>
                Manage employee cards, employee information,
                issue dates, expiry dates, and card statuses.
            </p>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- MENU ITEM                                               -->
    <!-- ===================================================== -->
    <menuitem
            id="menu_employee_card"
            name="Employee Card"
            action="action_employee_card"
            sequence="45"/>

</odoo>
