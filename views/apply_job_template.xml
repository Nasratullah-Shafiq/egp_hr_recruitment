<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="apply_job_form" name="Accept app">
        <t t-call="website.layout">
            <h1 class="text-center">This is Job Application Form</h1>
            <div class="wrap">
                <div class="oe_structure">
                    <div class="container">
                        <form role="form" method="post" action="/apply/job/submission">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label for="name" class="col-sm-2 col-form-label">Name</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="name" id="name" t-att-required="true"
                                       placeholder="IT"/>
                            </div>
                            <label for="code" class="col-sm-2 col-form-label">Code</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="code" id="code" t-att-required="true"
                                       placeholder="P-IT"/>
                            </div>
                            <p class="text-center">
                                <div class="clearfix oe_login_buttons">
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </p>
                        </form>
                    </div>
                </div>
            </div>

        </t>
    </template>

    <!-- thank message template -->
    <record id="job_apply_thanks" model="website.page">
        <field name="name">Thanks (Apply Job)</field>
        <field name="type">qweb</field>
        <field name="url">/apply-thank-you</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">egp_hr_recruitment.job_apply_thanks</field>
        <field name="arch" type="xml">
            <t name="Thanks (Job Apply)" t-name="egp_hr_recruitment.job_apply_thanks">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-7 col-xl-6 me-lg-auto">
                                        <span class="d-block fa fa-4x fa-thumbs-up mx-auto rounded-circle bg-primary"/>
                                        <br/>
                                        <h1 class="text-center">Thank You!</h1>
                                        <div class="pb16 pt16 s_hr" data-snippet="s_hr" data-name="Separator">
                                            <hr class="mx-auto border-top w-50 border-dark text-center"/>
                                        </div>
                                        <h5 class="text-center">
                                            <span class="fa fa-check-circle"/>
                                            <span>Your job application has been sent
                                                <b>successfully</b>
                                            </span>
                                        </h5>
                                        <p class="text-center">We will get back to you shortly.</p>
                                    </div>
                                    <div class="col-lg-4">
                                        <ul class="tree-unstyled mb-0 ps-2">
                                            <!--                                            <li>Ministry of Communication and IT</li>-->
                                            <t t-esc="company.name"/>
                                            <li>
                                                <i class="fa fa-map-marker fa-fw me-2"/>
                                                <!--                                                <span class="o_force_ltr">Mohammad Jan Khan Watt, Kabul, Afghanistan</span>-->
                                                <span class="o_force_ltr">
                                                    <t t-esc="company.partner_id.street"/>,
                                                    <t t-esc="company.partner_id.city"/>,
                                                    <t t-esc="company.partner_id.country_id.name"/>
                                                </span>
                                            </li>
                                            <li t-if="company.phone">
                                                <i class="fa fa-phone fa-fw me-2"/>
                                                <span class="o_force_ltr">
                                                    <t t-esc="company.phone"/>
                                                </span>
                                            </li>
                                            <li t-if="company.email">
                                                <i class="fa fa-1x fa-fw fa-envelope me-2"/>
                                                <span>
                                                    <t t-esc="company.email"/>
                                                </span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

</odoo>
