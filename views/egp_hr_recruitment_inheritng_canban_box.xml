        <!-- Add search filter for Hired and Empty Employee state -->
        <record id="inherit_hr_job_search_view" model="ir.ui.view">
            <field name="name">hr.job.search.inherit</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_job_filter"/>
            <field name="arch" type="xml">

                <xpath expr="//search" position="inside">
                    <separator/>
                    <!-- positions WITH hired employees -->
                    <filter name="with_hired_employees"
                            string="With Hired Employees"
                            domain="[('no_of_hired_employee', '>', 0)]"
                            help="Positions that have at least one hired employee"/>

                    <!-- WITHOUT hired employees (Empty positions) -->
                    <filter name="without_hired_employees"
                            string="📭 Empty Positions (No Hired Employees)"
                            domain="['|', ('no_of_hired_employee', '=', 0), ('no_of_hired_employee', '=', False)]"
                            help="Positions with no hired employees yet"/>

                    <!-- Combined filter group -->
                    <filter name="hiring_status_group"
                            string="Hiring Status"
                            groups="base.group_user">
                        <filter name="has_hired"
                                string="Has Hired Employees"
                                domain="[('no_of_hired_employee', '>', 0)]"/>
                        <filter name="no_hired"
                                string="No Hired Employees (Empty)"
                                domain="['|', ('no_of_hired_employee', '=', 0), ('no_of_hired_employee', '=', False)]"/>
                    </filter>

                    <separator/>

                    <filter name="group_by_hiring_status"
                            string="Group by Hiring Status"
                            context="{'group_by': 'no_of_hired_employee'}"
                            help="Group positions by number of hired employees"/>

                    <filter name="group_by_hired_count"
                            string="Group by Hired Count"
                            context="{'group_by': 'no_of_hired_employee'}"
                            help="Group by count of hired employees (0, 1, 2, etc.)"/>

                    <!-- Group by department with hiring filter -->
                    <filter name="group_by_department_hiring"
                            string="Department with Hiring Status"
                            context="{'group_by': 'department_id'}"
                            help="Group by department"/>

                    <!-- Group by recruitment stage -->
                    <filter name="group_by_stage"
                            string="Recruitment Stage"
                            context="{'group_by': 'stage_id'}"
                            help="Group by recruitment stage"/>

                </xpath>
            </field>
        </record>


        <!-- Inherit Applicant Search View -->
        <record id="view_hr_applicant_search_inherit_stage" model="ir.ui.view">
            <field name="name">hr.applicant.search.inherit.stage</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search_bis"/>
            <field name="arch" type="xml">

                <!-- Add Filter by Stage -->
                <xpath expr="//search" position="inside">
                    <separator/>

                    <filter name="filter_stage_open"
                            string="Open Stage"
                            domain="[('stage_id.fold','=',False)]"/>

                    <filter name="filter_stage_closed"
                            string="Closed Stage"
                            domain="[('stage_id.fold','=',True)]"/>
                    <filter name="stage_interview"
                            string="Interview"
                            domain="[('stage_id.name','=','Interview')]"/>
                </xpath>

                <!-- Add Group By Stage -->
                <xpath expr="//search/group" position="inside">
                    <filter name="group_by_stage"
                            string="Stage"
                            context="{'group_by': 'stage_id'}"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>


